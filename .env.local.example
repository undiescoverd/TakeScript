# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Collaboration (Hocuspocus WebSocket server)
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234

# AI Provider API Keys
# Required for AI features to work
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here

# Feature Flags
# Template System - Controls all template-related features
# Default: enabled in development, disabled in production
# Set to "true" to explicitly enable in production
NEXT_PUBLIC_FEATURE_TEMPLATES=true
NEXT_PUBLIC_FEATURE_TEMPLATES_LIBRARY=true
NEXT_PUBLIC_FEATURE_TEMPLATES_SAVE=true

# AI Features - All disabled by default, must be explicitly enabled
# Master switch for all AI features
NEXT_PUBLIC_FEATURE_AI=false

# Individual AI feature flags (only work if NEXT_PUBLIC_FEATURE_AI=true)
NEXT_PUBLIC_FEATURE_AI_CHAT=false
NEXT_PUBLIC_FEATURE_AI_BRAND_GUIDELINES=false
NEXT_PUBLIC_FEATURE_AI_GRAMMAR_CHECK=false
NEXT_PUBLIC_FEATURE_AI_REVIEW=false
NEXT_PUBLIC_FEATURE_AI_GENERATION=false
NEXT_PUBLIC_FEATURE_AI_INLINE=false

# OpenRouter (Alternative AI Provider)
# OpenRouter provides unified access to multiple AI models
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://takescript.app
OPENROUTER_APP_NAME=TakeScript
